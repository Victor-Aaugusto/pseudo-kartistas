<% const piloto = typeof user !== 'undefined' && user ? user : {} %>
<% const dashboardDisponivel = typeof dashboard !== 'undefined' && dashboard %>
<% const estatisticas = dashboardDisponivel ? dashboard : {} %>
<% const pontosPorCampeonato = Array.isArray(estatisticas.pontosPorCampeonato) ? estatisticas.pontosPorCampeonato : [] %>
<%- include('partials/header', { title: 'Perfil do piloto' }) %>

<section class="page-banner">
  <div class="container">
    <span class="eyebrow text-muted-green">PERFIL DO PILOTO</span>
    <h1><%= piloto.name || 'Piloto' %></h1>
    <p>Acompanhe o desempenho e os resultados na temporada.</p>
  </div>
</section>

<section class="container section-block">
  <div class="section-heading">
    <div>
      <span class="eyebrow text-muted-green">DESEMPENHO</span>
      <h2>Resumo da temporada</h2>
    </div>
    <a class="btn btn-outline-light btn-sm" href="/classificacao">Ver classificação</a>
  </div>

  <% if (!dashboardDisponivel) { %>
    <div class="alert alert-secondary" role="status">
      As estatísticas aparecerão aqui quando os dados do dashboard forem carregados.
    </div>
  <% } %>

  <div class="row g-3 dashboard-stats">
    <div class="col-6 col-lg">
      <article class="dashboard-stat-card">
        <span>Campeonatos</span>
        <strong><%= dashboardDisponivel ? (estatisticas.totalCampeonatos ?? 0) : '—' %></strong>
      </article>
    </div>
    <div class="col-6 col-lg">
      <article class="dashboard-stat-card">
        <span>Corridas</span>
        <strong><%= dashboardDisponivel ? (estatisticas.totalCorridas ?? 0) : '—' %></strong>
      </article>
    </div>
    <div class="col-4 col-lg">
      <article class="dashboard-stat-card podium-stat">
        <span>1º lugar</span>
        <strong><%= dashboardDisponivel ? (estatisticas.podios?.p1 ?? 0) : '—' %></strong>
      </article>
    </div>
    <div class="col-4 col-lg">
      <article class="dashboard-stat-card podium-stat">
        <span>2º lugar</span>
        <strong><%= dashboardDisponivel ? (estatisticas.podios?.p2 ?? 0) : '—' %></strong>
      </article>
    </div>
    <div class="col-4 col-lg">
      <article class="dashboard-stat-card podium-stat">
        <span>3º lugar</span>
        <strong><%= dashboardDisponivel ? (estatisticas.podios?.p3 ?? 0) : '—' %></strong>
      </article>
    </div>
  </div>

  <article class="login-card mt-4">
    <div class="section-heading">
      <div>
        <span class="eyebrow text-muted-green">PONTUAÇÃO</span>
        <h2>Pontos por campeonato</h2>
      </div>
      <span class="championship-total"><%= pontosPorCampeonato.length %> <%= pontosPorCampeonato.length === 1 ? 'campeonato' : 'campeonatos' %></span>
    </div>

    <% if (pontosPorCampeonato.length > 0) { %>
      <div class="table-responsive">
        <table class="table dashboard-table align-middle mb-0">
          <thead>
            <tr>
              <th scope="col">Campeonato</th>
              <th scope="col" class="text-end">Pontos</th>
            </tr>
          </thead>
          <tbody>
            <% pontosPorCampeonato.forEach((item) => { %>
              <tr>
                <td><%= item.campeonatoNome || item.name || 'Campeonato' %></td>
                <td class="text-end fw-bold"><%= item.pontos ?? 0 %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="empty-state dashboard-empty">
        <h3><%= dashboardDisponivel ? 'Ainda sem pontuação' : 'Estatísticas indisponíveis' %></h3>
        <p><%= dashboardDisponivel ? 'Os pontos por campeonato aparecerão aqui após os resultados das corridas.' : 'As estatísticas serão exibidas quando estiverem disponíveis.' %></p>
      </div>
    <% } %>
  </article>

  <div class="d-flex flex-wrap gap-2 mt-4">
    <a class="btn btn-lime" href="/campeonatos">Explorar campeonatos</a>
    <a class="btn btn-outline-light" href="/corridas">Ver corridas</a>
    <a class="btn btn-ghost" href="/usuarios">Voltar para pilotos</a>
  </div>
</section>

<%- include('partials/footer') %>
