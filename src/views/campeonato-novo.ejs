<%- include('partials/header', { title: 'Novo campeonato' }) %>
<section class="page-banner">
  <div class="container">
    <span class="eyebrow text-muted-green">TEMPORADA</span>
    <h1>Novo campeonato</h1>
    <p>Crie um campeonato para organizar as corridas e os resultados.</p>
  </div>
</section>

<section class="container section-block">
  <div class="login-card">
    <div class="section-heading">
      <div>
        <span class="eyebrow text-muted-green">DADOS DO CAMPEONATO</span>
        <h2>Informações</h2>
      </div>
    </div>

    <form class="row g-3" method="post" action="/campeonatos">
      <div class="col-12">
        <label class="form-label" for="name">Nome do campeonato</label>
        <input class="form-control" type="text" id="name" name="name" maxlength="255" placeholder="Ex.: Campeonato Paulista" required>
      </div>
      <div class="col-12 d-flex flex-wrap gap-2 mt-4">
        <button class="btn btn-lime" type="submit">Salvar campeonato</button>
        <a class="btn btn-outline-light" href="/campeonatos">Cancelar</a>
      </div>
    </form>
  </div>
</section>
<%- include('partials/footer') %>
